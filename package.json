{
  "name": "dsh-rss-monitor",
  "version": "0.2.1",
  "description": "RSS 璁㈤槄鐩戞帶鎻掍欢锛氬畾鏃舵鏌?RSS 婧愩€佸叧閿瘝杩囨护銆侀偖浠堕€氱煡锛屽苟浠ュ師鐢熻缃〉鎺ュ叆 DeepSeek Harness銆?Monitor RSS feeds on a schedule, filter by keywords, and get email notifications, as a native DeepSeek Harness settings page.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rss",
    "monitor",
    "notification",
    "email",
    "feed"
  ],
  "author": {
    "name": "dsh-rss contributors"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hgl011091/dsh-rss-monitor.git"
  },
  "homepage": "https://github.com/hgl011091/dsh-rss-monitor#readme",
  "bugs": "https://github.com/hgl011091/dsh-rss-monitor/issues",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "plugin-src",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "0.25.9",
    "esbuild-wasm": "0.25.9",
    "nodemailer": "6.9.10",
    "rss-parser": "3.13.0"
  }
}
